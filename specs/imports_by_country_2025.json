{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "XX",
    "anchor": "start",
    "subtitle": "XX | Source: HMRC API",
    "fontSize": 14,
    "subtitleFontSize": 12,
    "color": "#000000",
    "subtitleColor": "#000000"
  },
  "height": 250,
  "width": "container",
  "autosize": {"type": "fit", "contains": "padding"},
  "background": "#ffffff",
  "view": {"fill": "#ffffff", "strokeOpacity": 0},
  "data": {
    "url": "https://raw.githubusercontent.com/franco-sebastiani/franco-sebastiani.github.io/main/data/processed/imports_by_country_2025.csv",
    "format": {"type": "csv"}
  },
  "mark": {"type": "circle", "color": "#f4134d", "strokeWidth": 2},
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "axis": {"title": "", "titleColor": "#122B39", "grid": false}
    },
    "y": {
      "field": "value_gbp_m",
      "type": "quantitative",
      "axis": {"title": "", "titleColor": "#122B39", "grid": false}
    },
    "size": {
      "field": "minerals_supplied",
      "type": "quantitative",
      "legend": {"title": "Imports (£m)", "titleColor": "#122B39", "labelColor": "#122B39"}
    }
  },
  "config": {}
}
